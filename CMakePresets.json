{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Newest installed Visual Studio, x64. Point CMAKE_PREFIX_PATH at your Qt installation.",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-cuda",
      "inherits": "windows-base",
      "displayName": "Windows x64, CUDA",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "USE_CUDA": "ON",
        "CUDA_ARCH": "89"
      }
    },
    {
      "name": "windows-cpu",
      "inherits": "windows-base",
      "displayName": "Windows x64, CPU only",
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "USE_CUDA": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda-release",
      "configurePreset": "windows-cuda",
      "configuration": "Release"
    },
    {
      "name": "cpu-release",
      "configurePreset": "windows-cpu",
      "configuration": "Release"
    }
  ]
}
